{
  "extends": "@kutur-kit/tsconfig/effect.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "includeSuggestionsInTsc": false,
        "overrides": [
          {
            "include": ["src/**/*.ts"],
            "options": {
              "namespaceImportPackages": ["effect", "@stylexjs/stylex"],
              "topLevelNamedReexports": "follow"
            }
          }
        ]
      }
    ],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "*.config.ts"],
  "exclude": ["test/errors/**"]
}
