{
  "extends": "@kutur-kit/tsconfig/effect.json",
  "compilerOptions": {
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "includeSuggestionsInTsc": false,
        "allowedUnstableApis": [
          "@effect/sql-pg",
          "@effect/vitest",
          "effect/crypto",
          "effect/reactivity",
          "effect/sql"
        ],
        "overrides": [
          {
            "include": ["src/**/*.ts"],
            "options": {
              "namespaceImportPackages": ["effect"],
              "topLevelNamedReexports": "follow"
            }
          }
        ]
      }
    ],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
