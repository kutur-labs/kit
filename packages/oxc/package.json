{
  "name": "@kutur-kit/oxc",
  "version": "0.1.0-alpha.6",
  "description": "Oxlint and Oxfmt presets for TypeScript, with optional Effect and @kutur-kit/foldkit-stylex rules and a prose check for Markdown.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kutur-labs/kit.git",
    "directory": "packages/oxc"
  },
  "bin": {
    "kit-prose": "./src/prose/cli.ts"
  },
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "exports": {
    "./base": "./src/base.ts",
    "./effect": "./src/effect.ts",
    "./format": "./src/format.ts",
    "./anti-slop": "./src/anti-slop.ts",
    "./foldkit-stylex": "./src/foldkit-stylex.ts"
  },
  "publishConfig": {
    "bin": {
      "kit-prose": "./dist/prose/cli.js"
    },
    "exports": {
      "./base": {
        "types": "./dist/base.d.ts",
        "default": "./dist/base.js"
      },
      "./effect": {
        "types": "./dist/effect.d.ts",
        "default": "./dist/effect.js"
      },
      "./format": {
        "types": "./dist/format.d.ts",
        "default": "./dist/format.js"
      },
      "./anti-slop": {
        "types": "./dist/anti-slop.d.ts",
        "default": "./dist/anti-slop.js"
      },
      "./foldkit-stylex": {
        "types": "./dist/foldkit-stylex.d.ts",
        "default": "./dist/foldkit-stylex.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "build": "node --input-type=module -e 'import { rmSync } from \"node:fs\"; rmSync(\"dist\", { recursive: true, force: true });' && tsrs -p tsconfig.build.json && node scripts/write-json-preset.ts",
    "lint:package": "publint --pack pnpm --strict",
    "prepack": "pnpm run build",
    "test": "node --test test/*.test.ts",
    "typecheck": "effect-tsgo tsrs -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@oxlint/plugins": "catalog:runtime",
    "eslint": "catalog:runtime",
    "eslint-plugin-sonarjs": "catalog:runtime"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:tooling",
    "@kutur-kit/foldkit-stylex": "workspace:*",
    "@kutur-kit/tsconfig": "workspace:*",
    "@stylexjs/eslint-plugin": "catalog:tooling",
    "@types/node": "catalog:tooling",
    "oxfmt": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "publint": "catalog:tooling",
    "tsrs": "catalog:tooling"
  },
  "peerDependencies": {
    "@effect/tsgo": "catalog:peers",
    "@stylexjs/eslint-plugin": "catalog:peers",
    "oxfmt": "catalog:peers",
    "oxlint": "catalog:peers"
  },
  "peerDependenciesMeta": {
    "@effect/tsgo": {
      "optional": true
    },
    "@stylexjs/eslint-plugin": {
      "optional": true
    },
    "oxfmt": {
      "optional": true
    },
    "oxlint": {
      "optional": true
    }
  }
}
