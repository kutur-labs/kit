{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.mutation.config.ts" },
  "tsconfigFile_comment": "The native compiler has no JS API for Stryker's tsconfig rewrite, and vitest does not read tsconfig",
  "tsconfigFile": "none",
  "mutate_comment": "Mutants inside stylex.create, defineMarker or the guard's probe break StyleX's compile instead of a behaviour",
  "mutate": [
    "src/**/*.ts",
    "!src/index.ts",
    "!src/internal/functional-styles.ts",
    "!src/internal/markers.stylex.ts",
    "!src/internal/compiled.ts"
  ],
  "reporters": ["clear-text", "progress", "html"],
  "htmlReporter": { "fileName": "reports/mutation/index.html" },
  "thresholds": { "high": 90, "low": 80, "break": null }
}
