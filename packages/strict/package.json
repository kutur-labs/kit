{
  "name": "@kutur-kit/strict",
  "version": "0.1.0",
  "description": "A pnpm hook that requires exact catalog versions for workspace dependencies and exact release-age exclusions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kutur-labs/kit.git",
    "directory": "packages/strict"
  },
  "files": [
    "pnpmfile.mjs"
  ],
  "type": "module",
  "exports": {
    "./pnpmfile.mjs": "./pnpmfile.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "lint:package": "publint --pack pnpm --strict",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsrs -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@kutur-kit/tsconfig": "workspace:*",
    "@types/node": "catalog:tooling",
    "publint": "catalog:tooling",
    "tsrs": "catalog:tooling"
  }
}
