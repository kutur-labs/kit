{
  "name": "kutur-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "check": "pnpm format:check && turbo run lint lint:repo lint:package typecheck typecheck:repo test",
    "dev": "turbo run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "turbo run lint lint:repo",
    "lint:fix": "oxlint --fix .",
    "lint:package": "turbo run lint:package",
    "lint:repo": "oxlint .",
    "prepare": "effect-tsgo patch --oxlint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck typecheck:repo",
    "typecheck:repo": "tsc --noEmit"
  },
  "devDependencies": {
    "@effect/tsgo": "catalog:tooling",
    "@kutur-kit/oxc": "workspace:*",
    "@kutur-kit/tsconfig": "workspace:*",
    "@types/node": "catalog:tooling",
    "oxfmt": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "oxlint-tsgolint": "catalog:tooling",
    "publint": "catalog:tooling",
    "skills": "catalog:tooling",
    "turbo": "catalog:tooling",
    "typescript": "catalog:tooling"
  },
  "engines": {
    "node": "24.21.0",
    "pnpm": "12.10.1"
  },
  "packageManager": "pnpm@12.10.1"
}
