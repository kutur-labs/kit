{
  "name": "kutur-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "turbo run bench",
    "build": "turbo run build",
    "check": "pnpm format:check && turbo run lint lint:repo lint:package lint:structure typecheck typecheck:repo test",
    "commitlint": "commitlint --strict",
    "db:down": "docker compose down",
    "db:up": "docker compose up --detach --wait",
    "dev": "turbo run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "turbo run lint lint:repo lint:structure",
    "lint:fix": "oxlint --fix .",
    "lint:package": "turbo run lint:package",
    "lint:repo": "oxlint .",
    "lint:structure": "konsistent check --error-on-warnings",
    "prepare": "effect-tsgo patch --oxlint && husky",
    "test": "turbo run test",
    "test:mutation": "turbo run test:mutation",
    "typecheck": "turbo run typecheck typecheck:repo",
    "typecheck:repo": "tsc --noEmit"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:tooling",
    "@commitlint/config-conventional": "catalog:tooling",
    "@commitlint/types": "catalog:tooling",
    "@effect/tsgo": "catalog:tooling",
    "@kutur-kit/oxc": "workspace:*",
    "@kutur-kit/tsconfig": "workspace:*",
    "@types/node": "catalog:tooling",
    "husky": "catalog:tooling",
    "konsistent": "catalog:tooling",
    "oxfmt": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "oxlint-tsgolint": "catalog:tooling",
    "publint": "catalog:tooling",
    "skills": "catalog:tooling",
    "turbo": "catalog:tooling",
    "typescript": "catalog:tooling"
  },
  "engines": {
    "node": "24.22.0",
    "pnpm": "12.14.0"
  },
  "packageManager": "pnpm@12.14.0+sha512.c18ba6d87993d3d164cb5e8948f32b2c06ee854487e06cd8d86781342fb3e5bb4634367034711e86802baa9c37bea906ce1929ad08d70884c97d801df13389a6"
}
