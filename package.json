{
  "name": "kutur-kit",
  "private": true,
  "type": "module",
  "scripts": {
    "bench": "turbo run bench",
    "build": "turbo run build",
    "changeset": "changeset",
    "check": "pnpm format:check && turbo run lint lint:repo lint:package lint:prose lint:structure typecheck typecheck:repo test",
    "commitlint": "commitlint --strict",
    "db:down": "docker compose down",
    "db:up": "docker compose up --detach --wait",
    "dev": "turbo run dev",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "lint": "turbo run lint lint:repo lint:prose lint:structure",
    "lint:fix": "effect-tsgo --tsrs-lint oxlint --fix .",
    "lint:package": "turbo run lint:package",
    "lint:prose": "kit-prose '*.md' '.agents/skills/*/SKILL.md' '.changeset/*.md' '{apps,packages,tooling}/*/README.md'",
    "lint:repo": "effect-tsgo --tsrs-lint oxlint .",
    "lint:structure": "konsistent check --error-on-warnings",
    "prepare": "husky",
    "release": "pnpm build && pnpm check && turbo run test:browser test:packed && changeset publish",
    "release:version": "changeset version",
    "test": "turbo run test",
    "test:mutation": "turbo run test:mutation",
    "typecheck": "turbo run typecheck typecheck:repo",
    "typecheck:repo": "effect-tsgo tsrs --noEmit"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:tooling",
    "@commitlint/cli": "catalog:tooling",
    "@commitlint/config-conventional": "catalog:tooling",
    "@commitlint/types": "catalog:tooling",
    "@effect/tsgo": "catalog:tooling",
    "@kutur-kit/oxc": "workspace:*",
    "@kutur-kit/tsconfig": "workspace:*",
    "@types/node": "catalog:tooling",
    "husky": "catalog:tooling",
    "konsistent": "catalog:tooling",
    "oxfmt": "catalog:tooling",
    "oxlint": "catalog:tooling",
    "publint": "catalog:tooling",
    "skills": "catalog:tooling",
    "tsrs": "catalog:tooling",
    "turbo": "catalog:tooling"
  },
  "engines": {
    "node": "26.13.0",
    "pnpm": "12.18.0"
  },
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3"
}
