{
  "extends": "@kutur-kit/tsconfig/effect.json",
  "compilerOptions": {
    "noEmit": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "diagnostics": true,
        "includeSuggestionsInTsc": false,
        "allowedUnstableApis": [
          "@effect/sql-pg",
          "@effect/vitest",
          "effect/http",
          "effect/reactivity"
        ]
      }
    ],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
