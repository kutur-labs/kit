{
  "extends": ["//"],
  "tasks": {
    "build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/README.md",
        "$TURBO_ROOT$/packages/*/package.json"
      ],
      "outputs": [
        "dist/**",
        ".output/**",
        ".source/**",
        "src/route-tree.gen.ts",
        "content/docs/packages/**",
        "content/docs/guides/**",
        "content/docs/index.mdx"
      ]
    },
    "typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "lint": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
