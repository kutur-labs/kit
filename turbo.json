{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/packages/oxc/src/vendor/anti-slop/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/compose.yaml",
        "$TURBO_ROOT$/.github/workflows/ci.yml"
      ],
      "env": [
        "TEST_POSTGRES_URL",
        "TEST_S3_ENDPOINT",
        "TEST_S3_ACCESS_KEY_ID",
        "TEST_S3_SECRET_ACCESS_KEY",
        "TEST_S3_REGION",
        "TEST_R2_LIVE"
      ],
      "passThroughEnv": [
        "DOCKER_HOST",
        "DOCKER_CERT_PATH",
        "DOCKER_TLS_VERIFY",
        "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE",
        "TESTCONTAINERS_HOST_OVERRIDE",
        "TESTCONTAINERS_REUSE_ENABLE",
        "TESTCONTAINERS_RYUK_DISABLED"
      ],
      "outputs": []
    },
    "bench": {
      "dependsOn": ["^build"],
      "cache": false,
      "env": [
        "TEST_POSTGRES_URL",
        "TEST_S3_ENDPOINT",
        "TEST_S3_ACCESS_KEY_ID",
        "TEST_S3_SECRET_ACCESS_KEY",
        "TEST_S3_REGION"
      ],
      "passThroughEnv": [
        "DOCKER_HOST",
        "DOCKER_CERT_PATH",
        "DOCKER_TLS_VERIFY",
        "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE",
        "TESTCONTAINERS_HOST_OVERRIDE",
        "TESTCONTAINERS_REUSE_ENABLE",
        "TESTCONTAINERS_RYUK_DISABLED"
      ]
    },
    "test:mutation": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/compose.yaml",
        "$TURBO_ROOT$/.github/workflows/ci.yml"
      ],
      "env": [
        "TEST_POSTGRES_URL",
        "TEST_S3_ENDPOINT",
        "TEST_S3_ACCESS_KEY_ID",
        "TEST_S3_SECRET_ACCESS_KEY",
        "TEST_S3_REGION"
      ],
      "passThroughEnv": [
        "DOCKER_HOST",
        "DOCKER_CERT_PATH",
        "DOCKER_TLS_VERIFY",
        "TESTCONTAINERS_DOCKER_SOCKET_OVERRIDE",
        "TESTCONTAINERS_HOST_OVERRIDE",
        "TESTCONTAINERS_REUSE_ENABLE",
        "TESTCONTAINERS_RYUK_DISABLED"
      ],
      "outputs": ["reports/mutation/**"]
    },
    "//#lint:repo": {
      "dependsOn": ["^build", "@kutur-kit/docs#build"],
      "outputs": []
    },
    "//#typecheck:repo": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint:package": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/pnpm-workspace.yaml", "$TURBO_ROOT$/.gitignore"],
      "outputs": []
    },
    "//#lint:structure": {
      "outputs": []
    }
  },
  "globalDependencies": [".node-version"]
}
