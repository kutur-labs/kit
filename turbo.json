{
  "$schema": "https://turborepo.com/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/oxlint.config.ts",
        "$TURBO_ROOT$/tsconfig.json",
        "$TURBO_ROOT$/packages/oxc/src/vendor/anti-slop/**"
      ]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#lint:repo": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "//#typecheck:repo": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "lint:package": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/pnpm-workspace.yaml", "$TURBO_ROOT$/.gitignore"],
      "outputs": []
    },
    "//#lint:structure": {
      "outputs": []
    }
  },
  "globalDependencies": [".node-version"]
}
